CC = arm-none-eabi-gcc
CC = gcc
INCLUDES = \
	-I$(PWD)/jimtcl/\
	-I$(PWD)/src/flash/\
	-I$(PWD)/src/helper/\
	-I$(PWD)/src/
DEFINES = \
	  -DHAVE_SYS_TIME_H\
	  -DHAVE_GETTIMEOFDAY\
	  -DHAVE_STRNDUP\
	  -DHAVE_STRNLEN\
	  -DHAVE_NO_AUTOCONF\
	  -DHAVE_USLEEP\
	  -DUNUSEDLASTDEFINE
CCOPT=\
      $(DEFINES)\
      $(INCLUDES)\
      -O0
